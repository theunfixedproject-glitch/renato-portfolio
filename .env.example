# Facoltativo: se impostata, il form contatti invia le email via Resend (https://resend.com).
# Senza chiave il form apre il client email del visitatore con il messaggio già compilato.
RESEND_API_KEY=
# Mittente verificato su Resend (es. "Portfolio <form@tuodominio.it>")
CONTACT_FROM=
NEXT_PUBLIC_SITE_URL=https://tuodominio.it
